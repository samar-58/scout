# Backend credentials
GROQ_API_KEY=your-groq-key
TAVILY_API_KEY=your-tavily-key

# PostgreSQL used by authenticated projects, runs, events, and reports
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scout

# Durable background research orchestration
INNGEST_APP_ID=scout
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-your-inngest-signing-key
# Local only: set to 1 when using `inngest dev`; omit in production.
INNGEST_DEV=

# Clerk backend verification
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# Optional: PEM public key from Clerk for networkless token verification
CLERK_JWT_KEY=
# Origins allowed in Clerk's session-token `azp` claim
CLERK_AUTHORIZED_PARTIES=http://localhost:3001,http://127.0.0.1:3001

# Comma-separated browser origins allowed to call the backend
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
